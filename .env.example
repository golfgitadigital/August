# ===================================================================
# AuGust Aurea Limited - Hostinger Environment Configuration
# Rename this file to '.env' on your Hostinger server or set via hPanel
# ===================================================================

# Hostinger Node.js Port (Hostinger sets this automatically; default 5000)
PORT=5000
CMS_SERVER_PORT=5000
NODE_ENV=production

# Hostinger MySQL Database Credentials
# (Find these in hPanel -> Databases -> Management)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_august_cms
DB_USER=u123456789_admin
DB_PASSWORD=YourStrongDatabasePassword123!

# Frontend API Base URL (leave empty or /api for same-domain)
VITE_API_URL=/api
